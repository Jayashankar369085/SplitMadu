rules_version = '2';

// SplitMadu — production Firestore security rules.
//
// Data model:
//   users/{uid}          — name, email, photoUrl, createdAt, nameSearch,
//                          onboardingCompleted
//   friendRequests/{id}  — senderId, receiverId, status(pending|accepted|
//                          declined), createdAt; id = "{senderId}_{receiverId}"
//   friendships/{id}     — user1 < user2 (canonical UID order), status
//                          'accepted', createdAt; id = "{user1}_{user2}"
//   expenses/{id}        — title, amount, category, paidBy, createdBy,
//                          participants(map), participantIds(array), createdAt
//   settlements/{id}     — from, to, amount, createdBy, createdAt
//
// Principles: everything requires auth; profiles readable for user search
// but writable only by their owner; expenses/settlements participant-scoped;
// friend requests writable only by sender (create) / receiver (status);
// friendships only creatable by the request receiver accepting.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- users ----------

    match /users/{userId} {
      // Any signed-in user may read profiles: required for user search.
      allow get, list: if isSignedIn();

      // A user can mint only their own profile with valid fields.
      // `uid` inside the doc must always equal the document id.
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'photoUrl', 'createdAt', 'nameSearch',
              'onboardingCompleted'])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.matches('[^@]+@[^@]+\\.[^@]+')
        && request.resource.data.photoUrl is string
        && request.resource.data.nameSearch is string
        && request.resource.data.nameSearch == request.resource.data.name.lower()
        && request.resource.data.onboardingCompleted == false
        && request.resource.data.createdAt == request.time;

      // Owner may update only their own profile; field set stays fixed and
      // nameSearch must remain consistent with name (post-write snapshot).
      allow update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'photoUrl', 'createdAt', 'nameSearch',
              'onboardingCompleted'])
        && request.resource.data.uid == userId
        && request.resource.data.nameSearch == request.resource.data.name.lower();

      // Profiles are never deleted (preserves referential integrity).
      allow delete: if false;
    }

    // ---------- friend requests ----------

    match /friendRequests/{requestId} {
      function validFields() {
        return request.resource.data.keys().hasOnly(
          ['senderId', 'receiverId', 'status', 'createdAt']);
      }

      function validPair() {
        return request.resource.data.senderId is string
          && request.resource.data.receiverId is string
          && request.resource.data.senderId != request.resource.data.receiverId;
      }

      // Sender creates a pending request addressed to someone else.
      allow create: if isSignedIn()
        && validFields()
        && validPair()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Both parties can read requests that involve them.
      allow get, list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);

      // Receiver may flip status pending -> accepted | declined, nothing else.
      allow update: if isSignedIn()
        && resource.data.senderId != request.auth.uid
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['senderId', 'receiverId', 'status', 'createdAt'])
        && (request.resource.data.status == 'accepted'
            || request.resource.data.status == 'declined');

      allow delete: if false;
    }

// ---------- friendships ----------

match /friendships/{friendshipId} {

  // Individual friendship document reads.
  allow get: if isSignedIn()
    && (
      resource.data.user1 == request.auth.uid
      || resource.data.user2 == request.auth.uid
    );

  // The app performs:
  //   where('user1', isEqualTo: uid)
  //   where('user2', isEqualTo: uid)
  //
  // Keep these as separate rules so Firestore can prove that
  // each query only returns friendships belonging to the user.

  allow list: if isSignedIn()
    && resource.data.user1 == request.auth.uid;

  allow list: if isSignedIn()
    && resource.data.user2 == request.auth.uid;

  // Friendship creation.
  allow create: if isSignedIn()
    && request.resource.data.user1 < request.resource.data.user2
    && request.resource.data.keys().hasOnly(
         ['user1', 'user2', 'status', 'createdAt'])
    && request.resource.data.user1 is string
    && request.resource.data.user2 is string
    && request.resource.data.user1 != request.resource.data.user2
    && request.resource.data.status == 'accepted'
    && request.resource.data.createdAt == request.time;

  // Friendships are permanent for the MVP.
  allow update, delete: if false;
}

    // ---------- expenses ----------

    match /expenses/{expenseId} {
      function validExpense() {
        return request.resource.data.keys().hasOnly(
          ['title', 'amount', 'category', 'paidBy', 'createdBy',
           'participants', 'participantIds', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.category is string
          && request.resource.data.paidBy is string
          && request.resource.data.createdBy is string
          && request.resource.data.participants is map
          && request.resource.data.participantIds is list
          && request.resource.data.createdAt == request.time;
      }

      allow get: if isSignedIn()
        && (request.auth.uid in resource.data.participants
            || request.auth.uid == resource.data.paidBy);

      // LIST rules are evaluated against the QUERY, not per-document.
      // The app queries `participantIds array-contains uid`, so the rule
      // constrains the same array — the canonical provably-safe pattern.
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      // Creator must be a participant and the payer must be a participant;
      // the client is responsible for shares summing to `amount`.
      allow create: if isSignedIn()
        && validExpense()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.paidBy in request.resource.data.participants;

      // Expenses are immutable history — settlements adjust balances.
      allow update, delete: if false;
    }

    // ---------- settlements ----------

    match /settlements/{settlementId} {
      function validSettlement() {
        return request.resource.data.keys().hasOnly(
          ['from', 'to', 'amount', 'createdBy', 'createdAt'])
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.createdBy is string
          && request.resource.data.createdAt == request.time;
      }

      function involvesMe() {
        return isSignedIn()
          && (resource.data.from == request.auth.uid
              || resource.data.to == request.auth.uid);
      }

      allow get, list: if involvesMe();

      // Either party may record a settlement; `from` is the payer.
      allow create: if isSignedIn()
        && validSettlement()
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.from == request.auth.uid
            || request.resource.data.to == request.auth.uid);

      allow update, delete: if false;
    }

    // ---------- deny everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
